[Unit]
Description=Financial Review Celery Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/financial-review/financial-review
ExecStart=/opt/financial-review/run_service.sh worker
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
