# 默认忽略仓库内容，仅纳入代码和必要工程配置。
*
!/.gitignore
!/AGENTS.md

# 后端 Python 代码
!/app/
!/app/**
!/engines/
!/engines/**

# 前端代码
!/front/
!/front/**

# 自动化测试代码
!/test/
!/test/**
!/tests/
!/tests/**

# 数据库迁移代码
!/alembic/
!/alembic/**

# 必要的项目配置和启动文件
!/*.py
!/*.toml
!/*.yaml
!/*.yml
!/*.json
!/*.ini
!/*.cfg
!/*.conf
!/*.env.example
!/Dockerfile
!/docker-compose.yml
!/docker-compose.yaml
!/Makefile
!/README.md

# Python/前端构建缓存和运行产物继续忽略
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
node_modules/
dist/
build/
coverage/
htmlcov/
var/
.learnings/
