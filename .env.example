# 应用基础配置
APP_NAME=财务单据智能风险审核系统
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_DIR=var/logs
APP_HOST=0.0.0.0
APP_PORT=8000
DOCUMENT_BACKEND=memory
AUTH_BACKEND=memory

# PostgreSQL、Redis 和 Celery
POSTGRES_DB=financial_review
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/financial_review
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_TIMEOUT_SECONDS=1800

# MinIO / FileStorage；生产环境请改为密钥管理系统提供的凭据
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio-password-change-me
MINIO_BUCKET=financial-review
MINIO_SECURE=false
MINIO_PRESIGNED_URL_TTL_SECONDS=300
LOCAL_STORAGE_PATH=var/uploads

# JWT 和认证限流
JWT_SECRET=development-only-change-me
JWT_ISSUER=financial-review
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
AUTH_REVOCATION_KEY_PREFIX=financial-review:auth:revoked
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# LLM：业务代码通过适配器调用；外部调用默认关闭
LLM_MODEL_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=http://llm:8000/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.0
LLM_PROMPT_VERSION=v1

# Embedding / RAG
EMBEDDING_MODEL_PROVIDER=openai-compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_HOST_PATH=./embedding/bge-large-zh-v1.5
EMBEDDING_MODEL_ID=/models/bge-large-zh-v1.5
EMBEDDING_BASE_URL=http://embedding:80/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60
RAG_TOP_K=5
RAG_RULE_VERSION=v1

# OCR；真实财务数据优先进入私有化 OCR 服务
OCR_PROVIDER=private
OCR_BASE_URL=http://ocr:8000
OCR_API_KEY=
OCR_MODEL=default
OCR_TIMEOUT_SECONDS=120
EXTERNAL_MODEL_CALLS_ENABLED=false
